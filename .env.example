# Production requires PostgreSQL, HR API, and a random session secret.
DATABASE_URL=postgresql://task:task@localhost:5432/task
TASK_AUTH_MODE=hr
TASK_ORIGIN=https://task.example.com
SESSION_SECRET=replace-with-at-least-32-random-characters
HR_API_URL=https://hr.example.com/api/task
# Comma-separated HR user IDs. Used only to bootstrap the first TASK admin.
TASK_BOOTSTRAP_ADMINS=
# Used to protect the due-notification job endpoint.
CRON_SECRET=

# Optional first-admin bootstrap from a verified HR Super Admin account
TASK_BOOTSTRAP_HR_ADMIN=false
# Separate local data when connecting real HR (development only)
TASK_DATA_DIR=.data/hr-postgres
