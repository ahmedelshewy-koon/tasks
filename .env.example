# ---- Required in production (placeholders only; never commit real values) ----
# PostgreSQL connection string. Add ?sslmode=require if your database needs TLS.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DATABASE
# At least 32 random characters, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
SESSION_SECRET=
# HR task API base URL. Must be HTTPS in production.
HR_API_URL=https://hr.example.com/api/task
# Exact public Tasks origin: scheme + host (+ port), no path or trailing slash. HTTPS only.
TASK_ORIGIN=https://tasks.example.com
# Random private token. The scheduler sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ---- Bootstrap-only (first TASK admin; inert once an admin exists) ----
# Comma-separated HR user IDs.
TASK_BOOTSTRAP_ADMINS=
# Set true temporarily to let the first verified HR Super Admin become admin.
TASK_BOOTSTRAP_HR_ADMIN=false

# ---- Development-only (ignored in production) ----
# `development` enables local identities; ignored when NODE_ENV=production.
TASK_AUTH_MODE=
# Local PGlite directory, used only when DATABASE_URL is unset.
TASK_DATA_DIR=
